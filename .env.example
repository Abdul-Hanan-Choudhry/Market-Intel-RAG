# Keep model caches on E: (C: has little free space)
HF_HOME=./.cache/huggingface
FASTEMBED_CACHE=./.cache/fastembed

# Name + email sent in the crawler User-Agent so site owners can reach you
CONTACT="Your Name your.email@example.com"

# Optional news APIs (free tiers)
FINNHUB_API_KEY=
MARKETAUX_API_KEY=

# Vector DB: "server" uses docker-compose Qdrant, "local" uses an embedded on-disk store
QDRANT_MODE=local
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=market_intel

# Models
EMBED_MODEL=BAAI/bge-small-en-v1.5
SPARSE_MODEL=Qdrant/bm25
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
LLM_REPO=bartowski/Llama-3.2-3B-Instruct-GGUF
LLM_FILE=Llama-3.2-3B-Instruct-Q4_K_M.gguf
LLM_CTX=4096
LLM_THREADS=4
# Faster, less reliable option (~3x faster on CPU) if you'd rather trade accuracy for speed:
# the 1B model sometimes mixes up which year/figure a number applies to in dense passages.
# LLM_REPO=bartowski/Llama-3.2-1B-Instruct-GGUF
# LLM_FILE=Llama-3.2-1B-Instruct-Q4_K_M.gguf

# Answering. On CPU every 100 context tokens adds several seconds before the first word.
CONTEXT_TOKEN_BUDGET=1200
ANSWER_K=4
LLM_MAX_TOKENS=300
REFUSE_BELOW=0.02
# If no new token for this long, report an error instead of hanging forever (e.g. CPU
# starved by other processes). If another question is still answering, fail fast instead.
LLM_STALL_TIMEOUT_S=150
LLM_BUSY_WAIT_S=3

# "local" = GGUF in-process via llama.cpp. "openai" = any OpenAI-compatible server:
#   Ollama:       OPENAI_BASE_URL=http://localhost:11434/v1   OPENAI_MODEL=llama3.2:3b
#   llama-server: OPENAI_BASE_URL=http://localhost:8080/v1
#   Groq (free):  OPENAI_BASE_URL=https://api.groq.com/openai/v1  OPENAI_API_KEY=...  OPENAI_MODEL=llama-3.1-8b-instant
LLM_BACKEND=local
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=not-needed
OPENAI_MODEL=llama3.2:3b

# Where the Streamlit UI finds the API
API_URL=http://127.0.0.1:8000
